<Application x:Class="Launcher.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Launcher.UI">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Metrics.xaml" />
        <ResourceDictionary Source="Themes/Effects.xaml" />
        <ResourceDictionary Source="Themes/Animations.xaml" />
        <ResourceDictionary Source="Themes/Controls/Buttons.xaml" />
        <ResourceDictionary Source="Themes/GreenTheme.xaml" />
        <ResourceDictionary Source="Themes/Controls/Inputs.xaml" />
        <ResourceDictionary Source="Themes/Controls/Data.xaml" />
        <ResourceDictionary Source="Themes/Controls/Feedback.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:EqualsConverter x:Key="Eq"/>
      <local:PageVisibilityConverter x:Key="PageVis"/>
      <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
