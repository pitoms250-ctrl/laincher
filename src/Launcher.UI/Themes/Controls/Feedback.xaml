<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ProgressBar.Themed" TargetType="ProgressBar">
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent400}" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
            <Grid>
              <Track x:Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeat}" Focusable="False" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="PART_Indicator" Background="{TemplateBinding Foreground}">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeat}" Focusable="False" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
              </Track>
              <Border x:Name="MarqueeTrack" Visibility="Collapsed" ClipToBounds="True">
                <Border x:Name="Marquee" Width="48" HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}" CornerRadius="4">
                  <Border.RenderTransform><TranslateTransform X="-48" /></Border.RenderTransform>
                </Border>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="MarqueeTrack" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard Name="ProgressMarquee">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Marquee"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-48" To="72" Duration="0:0:0.8" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions><StopStoryboard BeginStoryboardName="ProgressMarquee" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style x:Key="Card.Glass" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <Style x:Key="Skeleton" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="{DynamicResource Color.Surface}" Offset="0" />
          <GradientStop Color="{DynamicResource Color.SurfaceHover}" Offset="0.5" />
          <GradientStop Color="{DynamicResource Color.Surface}" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    <Style.Triggers>
      <Trigger Property="IsVisible" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard Name="SkeletonPulse">
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               From="0.6" To="1"
                               Duration="0:0:1.2" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <StopStoryboard BeginStoryboardName="SkeletonPulse" />
        </Trigger.ExitActions>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>