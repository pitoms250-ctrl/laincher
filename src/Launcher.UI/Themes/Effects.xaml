<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DropShadowEffect x:Key="Effect.Shadow.Subtle"
                    Color="{DynamicResource Color.Bg0}"
                    BlurRadius="16"
                    ShadowDepth="2"
                    Opacity="0.35" />
  <DropShadowEffect x:Key="Effect.Glow.Accent"
                    Color="{DynamicResource Color.Accent400}"
                    BlurRadius="20"
                    ShadowDepth="0"
                    Opacity="0.35" />
</ResourceDictionary>