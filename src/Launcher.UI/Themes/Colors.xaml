<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Bg0">#040D0A</Color>
  <Color x:Key="Color.Bg1">#07140F</Color>
  <Color x:Key="Color.Bg2">#0B1F17</Color>

  <Color x:Key="Color.Surface">#0AFFFFFF</Color>
  <Color x:Key="Color.SurfaceHover">#12FFFFFF</Color>
  <Color x:Key="Color.SurfaceActive">#1AFFFFFF</Color>
  <Color x:Key="Color.Border">#1A78FFB4</Color>
  <Color x:Key="Color.BorderStrong">#3878FFB4</Color>

  <Color x:Key="Color.Accent400">#4ADE80</Color>
  <Color x:Key="Color.Accent500">#22C55E</Color>
  <Color x:Key="Color.Accent600">#16A34A</Color>
  <Color x:Key="Color.AccentGlow">#594ADE80</Color>

  <Color x:Key="Color.TextPrimary">#ECFDF5</Color>
  <Color x:Key="Color.TextSecondary">#A7C4B5</Color>
  <Color x:Key="Color.TextTertiary">#6B8A7A</Color>
  <Color x:Key="Color.Success">#4ADE80</Color>
  <Color x:Key="Color.Warning">#FBBF24</Color>
  <Color x:Key="Color.Danger">#F87171</Color>
  <Color x:Key="Color.Info">#60A5FA</Color>

  <SolidColorBrush x:Key="Brush.Bg0" Color="{DynamicResource Color.Bg0}" />
  <SolidColorBrush x:Key="Brush.Bg1" Color="{DynamicResource Color.Bg1}" />
  <SolidColorBrush x:Key="Brush.Bg2" Color="{DynamicResource Color.Bg2}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.SurfaceActive" Color="{DynamicResource Color.SurfaceActive}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.Accent400" Color="{DynamicResource Color.Accent400}" />
  <SolidColorBrush x:Key="Brush.Accent500" Color="{DynamicResource Color.Accent500}" />
  <SolidColorBrush x:Key="Brush.Accent600" Color="{DynamicResource Color.Accent600}" />
  <SolidColorBrush x:Key="Brush.AccentGlow" Color="{DynamicResource Color.AccentGlow}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{DynamicResource Color.TextTertiary}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{DynamicResource Color.Info}" />
</ResourceDictionary>