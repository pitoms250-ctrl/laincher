<UserControl x:Class="Launcher.UI.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Профиль" Style="{StaticResource Text.H1}" />
          <TextBlock Text="Аккаунт Microsoft и лицензия Minecraft" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,7">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ProfileAccountStatus}" Style="{StaticResource Text.Caption}" />
          </StackPanel>
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent400}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.95*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="1.05*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource Card.Glass}" Padding="14" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Button Command="{Binding SelectProfilePhotoCommand}" ToolTip="Выбрать фото профиля"
                        Padding="0" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}"
                        Background="{DynamicResource Brush.Bg1}" Height="112" Width="112" ClipToBounds="True">
                  <Grid>
                    <Border Background="{DynamicResource Brush.Accent600}" CornerRadius="10">
                      <TextBlock Text="{Binding AvatarLetter}" FontSize="32" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding ProfilePhoto}" Stretch="UniformToFill"
                           Visibility="{Binding HasProfilePhoto, Converter={StaticResource BoolToVis}}" />
                    <Border VerticalAlignment="Bottom" Background="#CC07140F" Padding="4">
                      <TextBlock Text="Выбрать фото" FontSize="10" HorizontalAlignment="Center" />
                    </Border>
                  </Grid>
                </Button>
                <TextBlock Text="{Binding MinecraftLicenseStatus}" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Accent400}" TextWrapping="Wrap" Margin="2,7,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding MinecraftLicenseStatus}" Value="Куплена">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Accent400}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MinecraftLicenseStatus}" Value="Не куплена">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="ИМЯ В ИГРЕ" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ProfileDisplayName}" Style="{StaticResource Text.H2}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Xbox Gamertag" Style="{StaticResource Text.Caption}" Margin="0,8,0,1" />
                <TextBlock Text="{Binding ProfileGamertag}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="UUID" Style="{StaticResource Text.Caption}" Margin="0,7,0,1" />
                <TextBlock Text="{Binding ProfileUuid}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource Button.Secondary}" MinHeight="32" Padding="10,4"
                          Content="Скины" Command="{Binding NavigateCommand}" CommandParameter="Skins" />
                  <Button Style="{StaticResource Button.Ghost}" MinHeight="32" Padding="10,4" Margin="4,0,0,0"
                          Content="Копировать UUID" Command="{Binding CopyProfileUuidCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ProfileActionMessage}" Style="{StaticResource Text.Caption}"
                     TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card.Glass}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Статистика" Style="{StaticResource Text.H3}" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="{Binding ProfileLaunchCount}" FontSize="22" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Accent400}" HorizontalAlignment="Center" />
                  <TextBlock Text="запусков" Style="{StaticResource Text.Caption}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource Brush.Border}" Margin="0,3" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding ProfilePlaytime}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Text="в игре" Style="{StaticResource Text.Caption}" />
                </StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource Brush.Border}" Margin="0,3" />
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding ProfileLastVersion}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="последняя версия" Style="{StaticResource Text.Caption}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card.Glass}" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Облачный профиль" Style="{StaticResource Text.H3}" />
                <TextBlock Text="Синхронизация профиля и диагностика. Передаются язык, действия и версии." 
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding ContactEmailMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
              <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch.Themed}"
                            IsChecked="{Binding ShareDiagnostics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Включить или выключить облачную синхронизацию и диагностику" />
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card.Glass}" Padding="14" Margin="0,0,0,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Аккаунт Microsoft" Style="{StaticResource Text.H3}" />
                <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" MinHeight="30" Padding="10,4"
                        Content="{Binding ProfileActionLabel}" Command="{Binding AccountCommand}" />
              </Grid>
              <Grid Grid.Row="1" Margin="0,12,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Brush.Bg1}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                  <UniformGrid Rows="2" Columns="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Fill="#F25022" Margin="0,0,1,1" />
                    <Rectangle Fill="#7FBA00" Margin="1,0,0,1" />
                    <Rectangle Fill="#00A4EF" Margin="0,1,1,0" />
                    <Rectangle Fill="#FFB900" Margin="1,1,0,0" />
                  </UniformGrid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ProfileEmail}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ProfileAccountStatus}" Style="{StaticResource Text.Caption}" />
                </StackPanel>
              </Grid>
              <Border Grid.Row="2" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,6" />
              <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Xbox Gamertag" Style="{StaticResource Text.Caption}" />
                <TextBlock Grid.Column="1" Text="{Binding ProfileGamertag}" Style="{StaticResource Text.Small}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="Состояние входа" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileAccountStatus}" Style="{StaticResource Text.Small}"
                           Margin="0,6,0,0" />
              </Grid>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card.Glass}" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Лицензия Minecraft" Style="{StaticResource Text.H3}" />
                <Border Grid.Column="1" Padding="9,4">
                  <TextBlock Text="{Binding MinecraftLicenseStatus}" Style="{StaticResource Text.Caption}" />
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding MinecraftLicenseStatus}" Value="Куплена">
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent400}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
              </Grid>
              <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.SurfaceActive}"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="21"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MinecraftLicenseStatus}" Value="Куплена">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent400}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Minecraft: Java Edition" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="Лицензия проверяется через Microsoft" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="{Binding ProfileLicenseCheckMessage}" Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                    <Button Content="Купить Minecraft" Command="{Binding OpenMinecraftPurchaseCommand}"
                      ToolTip="Открыть официальный магазин Minecraft">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Button.Primary.Small}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MinecraftLicenseStatus}" Value="Куплена">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" MinHeight="32" Padding="8,4"
                          Content="Проверить снова" Command="{Binding RecheckMinecraftLicenseCommand}"
                          ToolTip="Обновить Microsoft-сессию и повторно проверить лицензию" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card.Glass}" Padding="14" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="FL Coins / инвентарь" Style="{StaticResource Text.H3}" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding WalletCoins, StringFormat={}{0} FL}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent400}" />
                  <TextBlock Text="{Binding WalletStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Padding="8,4" BorderThickness="1" CornerRadius="9" Background="{DynamicResource Brush.Bg1}">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WalletCoins}" Value="0">
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="Wallet" Style="{StaticResource Text.Caption}" />
                </Border>
              </Grid>

              <Border Margin="0,12,0,0" Padding="10" CornerRadius="10" Background="{DynamicResource Brush.Bg1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Купленные предметы" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                  <ItemsControl ItemsSource="{Binding OwnedShopItems}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="8" Background="{DynamicResource Brush.SurfaceActive}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Type}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ExpiresAt, StringFormat=до {0:dd.MM.yyyy}}" Margin="8,0,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExpiresAt}" Value="{x:Null}">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Пока ничего не куплено или не выдано." Margin="0,8,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasWalletInventory}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>

              <Border Margin="0,12,0,0" Padding="10" CornerRadius="10" Background="{DynamicResource Brush.Bg1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Кейсы в инвентаре" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                  <ItemsControl ItemsSource="{Binding CaseInventory}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="8" Background="{DynamicResource Brush.SurfaceActive}">
                          <TextBlock>
                            <Run Text="{Binding CaseId}" />
                            <Run Text=" × " />
                            <Run Text="{Binding Count}" Foreground="{DynamicResource Brush.Accent400}" />
                          </TextBlock>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>