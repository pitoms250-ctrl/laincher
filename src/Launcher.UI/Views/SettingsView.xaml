<UserControl x:Class="Launcher.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,8">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="128" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Настройки" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Папка игры, память и параметры запуска."
                     Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                </StackPanel>
                <Image Grid.Column="1" Width="120" Height="120" HorizontalAlignment="Right"
           Style="{StaticResource Decor.Rotate}"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
               Stretch="Uniform" SnapsToDevicePixels="True">
                    <Image.Source>
                        <BitmapImage UriSource="pack://application:,,,/imge/deco-tools.png" DecodePixelWidth="180" />
                    </Image.Source>
                </Image>
            </Grid>

            <Border Style="{StaticResource Card.Glass}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Хранилище" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="Папка игры" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Куда скачиваются игра, Java, моды и ассеты."
                       Style="{StaticResource Text.Small}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource TextBox.Mono}" IsReadOnly="True"
                     Text="{Binding GameFolder}" TextWrapping="Wrap" MinHeight="40" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Secondary}" Content="Сменить папку"
                      Command="{Binding ChangeGameFolderCommand}" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Открыть папку"
                      Command="{Binding OpenGameFolderCommand}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card.Glass}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Память" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="Максимум для Minecraft" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RamLabel}"
                         FontFamily="{DynamicResource Font.Mono}"
                         Foreground="{DynamicResource Brush.Accent400}" />
                            <TextBlock Text="Память Java (Xmx)" Style="{StaticResource Text.Body}" />
                        </DockPanel>
                        <Slider Style="{StaticResource Slider.Themed}" Minimum="1024" Maximum="16384"
                    TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding XmxMb}" ValueChanged="Slider_ValueChanged" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="1 ГБ" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="16 ГБ" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card.Glass}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Запуск" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="Дополнительные параметры JVM" Style="{StaticResource Text.Small}"
                       Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBox Style="{StaticResource TextBox.Mono}" MinHeight="72" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="{Binding JvmArgs, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="Показывать версии" Style="{StaticResource Text.Body}" Margin="0,16,0,8" />
                        <CheckBox Style="{StaticResource CheckBox.Themed}" IsChecked="{Binding ShowSnapshots}"
                      Content="Snapshot" Margin="0,0,0,8" />
                        <CheckBox Style="{StaticResource CheckBox.Themed}" IsChecked="{Binding ShowOld}"
                      Content="Beta и Alpha" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card.Glass}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Облачный профиль" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="Профиль CRM" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox Style="{StaticResource CheckBox.Themed}" IsChecked="{Binding ShareDiagnostics}"
                                            Content="Отправлять телеметрию и диагностику" />
                                                <TextBlock Text="При входе через Microsoft ник, email и UUID Minecraft синхронизируются с CRM для отображения профиля и поддержки. Эта настройка управляет дополнительными событиями, присутствием и данными устройства; тексты ошибок очищаются от локального пути."
                       Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card.Glass}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Контакт для новостей" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="Только по вашему согласию" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBox Style="{StaticResource TextBox.Mono}" MinHeight="38"
                                 Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsAuthenticated}" />
                        <CheckBox Style="{StaticResource CheckBox.Themed}" Margin="0,9,0,0"
                                  IsChecked="{Binding ContactEmailConsent}"
                                  Content="Согласен получать новости и сообщения о входе на эту почту" />
                        <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,9,0,0"
                                Command="{Binding SaveContactEmailCommand}" Content="Сохранить согласие" />
                        <TextBlock Text="{Binding ContactEmailMessage}" Style="{StaticResource Text.Small}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
