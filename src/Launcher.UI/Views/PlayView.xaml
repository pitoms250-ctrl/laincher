<UserControl x:Class="Launcher.UI.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.TextPrimary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.85*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="0.85*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Row="0" Grid.Column="0" MinHeight="288" Margin="0,0,0,16"
              CornerRadius="16" BorderBrush="{DynamicResource Brush.BorderStrong}"
              BorderThickness="1" ClipToBounds="True">
        <Grid>
          <Border>
            <Border.Background>
              <ImageBrush ImageSource="/Assets/hero.jpg" Stretch="UniformToFill" AlignmentX="Right" />
            </Border.Background>
          </Border>
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#F0040D0A" Offset="0" />
                <GradientStop Color="#C0040D0A" Offset="0.62" />
                <GradientStop Color="#26040D0A" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Grid Margin="24">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
              <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                <TextBlock FontSize="{DynamicResource Type.Caption}" FontWeight="SemiBold">
                  <Run Text="Версия: " />
                  <Run Text="{Binding SelectedVersionLabel, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent400}" />
                </TextBlock>
              </Border>
              <TextBlock Text="F Launcher" FontFamily="{DynamicResource Font.Display}"
                         FontSize="{DynamicResource Type.Display}" FontWeight="Bold"
                         TextWrapping="Wrap" Margin="0,12,0,0" />
              <TextBlock Text="Твой мир. Твои правила. Твой лаунчер."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="Выберите версию и нажмите «Играть»" Foreground="{DynamicResource Brush.TextSecondary}"
                         TextWrapping="Wrap" Margin="0,8,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StatsText}" Value="Вы ещё не запускали игру">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <Image Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Style="{StaticResource Decor.Float.Large}"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
                   Stretch="Uniform" SnapsToDevicePixels="True">
              <Image.Source><BitmapImage UriSource="pack://application:,,,/imge/deco-island.png" DecodePixelWidth="320" /></Image.Source>
            </Image>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource Button.Primary.Play}" Command="{Binding PlayCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="20" Margin="0,0,10,0" />
                  <TextBlock Text="ИГРАТЬ" />
                </StackPanel>
              </Button>
              <ComboBox Style="{StaticResource ComboBox.Themed}" Width="160" Margin="12,0,0,0"
                        ItemsSource="{Binding VersionList}" SelectedItem="{Binding SelectedVersion}"
                        DisplayMemberPath="Id" ToolTip="Выбрать версию" />
              <Button Style="{StaticResource IconButton.Themed}" Width="40" Margin="8,0,0,0"
                      Content="&#xE713;" FontFamily="{StaticResource IconFont}"
                      Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip="Настройки запуска" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card.Glass}" Margin="0,0,0,16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" MinHeight="32"
                    Padding="8,4" Content="Все новости"
                    Command="{Binding NavigateCommand}" CommandParameter="News" />
            <TextBlock Text="Новости" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
          </DockPanel>
          <Grid MaxHeight="280">
            <ListBox ItemsSource="{Binding News}" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Brush.TextPrimary}" ItemContainerStyle="{StaticResource PlainItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Padding="8" Background="{DynamicResource Brush.Surface}"
                          CornerRadius="{DynamicResource Radius.Small}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Border Height="56" CornerRadius="{DynamicResource Radius.Small}" ClipToBounds="True"
                              Background="{DynamicResource Brush.Bg2}">
                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border>
                      <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Type.Caption}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" />
                        <DockPanel Grid.Row="1" Margin="0,4,0,0">
                          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" MinHeight="28" Padding="6,2"
                                  Content="Читать"
                                  Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}" />
                          <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}" Style="{StaticResource Text.Caption}"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="True">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding News.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Новости пока недоступны" Style="{StaticResource Text.Small}"
                         HorizontalAlignment="Center" Margin="8" />
              <Button Style="{StaticResource Button.Secondary}" Content="Обновить"
                      Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Grid.ColumnSpan="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.5*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card.Glass}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" MinHeight="32"
                      Padding="8,4" Content="Все серверы"
                      Command="{Binding NavigateCommand}" CommandParameter="Online" />
              <TextBlock Text="Серверы" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
            </DockPanel>
                 <Image DockPanel.Dock="Bottom" Height="112" HorizontalAlignment="Right" Opacity="0.35"
                   Style="{StaticResource Decor.Float.Medium}"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
                   Stretch="Uniform" SnapsToDevicePixels="True">
              <Image.Source><BitmapImage UriSource="pack://application:,,,/imge/deco-village.png" DecodePixelWidth="240" /></Image.Source>
            </Image>
            <Grid MaxHeight="208">
              <ListBox ItemsSource="{Binding Servers}" Background="Transparent" BorderThickness="0"
                       Foreground="{DynamicResource Brush.TextPrimary}" ItemContainerStyle="{StaticResource PlainItem}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="8" Background="{DynamicResource Brush.Surface}"
                            CornerRadius="{DynamicResource Radius.Small}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Motd}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Players}" Foreground="{DynamicResource Brush.Accent400}" HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding PingMs, StringFormat={}{0} мс}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" MinHeight="32"
                                Padding="8,4" Content="Играть"
                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Серверы пока недоступны" Style="{StaticResource Text.Small}"
                           HorizontalAlignment="Center" Margin="8" />
                <Button Style="{StaticResource Button.Secondary}" Content="Обновить"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card.Glass}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Версия и Java" Style="{StaticResource Text.H3}" />
            <ComboBox Grid.Row="1" Style="{StaticResource ComboBox.Themed}" Margin="0,12,0,8"
                      ItemsSource="{Binding VersionList}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Id" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" Margin="0,5,8,0" />
              <TextBlock Text="{Binding JavaStatus}" FontSize="{DynamicResource Type.Small}"
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
              <Button Style="{StaticResource Button.Secondary}" Content="Проверить Java" Command="{Binding CheckJavaCommand}"
                      VerticalAlignment="Bottom" />
              <Image Grid.Column="1" Width="84" Height="84" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Style="{StaticResource Decor.Rotate}"
                     RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
                     Stretch="Uniform" SnapsToDevicePixels="True">
                <Image.Source><BitmapImage UriSource="pack://application:,,,/imge/deco-laptop.png" DecodePixelWidth="128" /></Image.Source>
              </Image>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
