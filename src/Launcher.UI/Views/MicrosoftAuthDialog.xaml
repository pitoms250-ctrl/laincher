<Window x:Class="Launcher.UI.Views.MicrosoftAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в Microsoft" Width="520" Height="640" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FontFamily="Inter, Montserrat, Segoe UI" Foreground="White" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <!-- Зелёная тема -->
    <SolidColorBrush x:Key="Panel" Color="#10241B"/>
    <SolidColorBrush x:Key="Panel2" Color="#17332A"/>
    <SolidColorBrush x:Key="Line" Color="#1F3D2F"/>
    <SolidColorBrush x:Key="Accent" Color="#22C55E"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1F22C55E"/>
    <SolidColorBrush x:Key="AccentEdge" Color="#7322C55E"/>
    <SolidColorBrush x:Key="Muted" Color="#7F9C8B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E9F5EE"/>
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#22C55E" Offset="0"/>
      <GradientStop Color="#16A34A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Красная тема (ошибка) -->
    <SolidColorBrush x:Key="ErrPanel" Color="#26110F"/>
    <SolidColorBrush x:Key="ErrLine" Color="#5C1F27"/>
    <SolidColorBrush x:Key="Err" Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrSoft" Color="#1FEF4444"/>
    <SolidColorBrush x:Key="ErrEdge" Color="#73EF4444"/>
    <SolidColorBrush x:Key="ErrMuted" Color="#B58585"/>
    <SolidColorBrush x:Key="ErrText" Color="#FDEAEA"/>
    <LinearGradientBrush x:Key="ErrGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#EF4444" Offset="0"/>
      <GradientStop Color="#DC2626" Offset="1"/>
    </LinearGradientBrush>

    <!-- Логотип FL -->
    <Canvas x:Key="FlLogo" x:Shared="False" Width="80" Height="80">
      <Rectangle Width="80" Height="80" RadiusX="17.5" RadiusY="17.5">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27A95F" Offset="0"/>
            <GradientStop Color="#135A33" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Path Canvas.Left="23.125" Canvas.Top="24.375" Data="M0,0 H20.875 V6.25 H6.875 V13.125 H19.375 V18.75 H6.875 V31.5 H0 Z">
        <Path.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#C9D1CC" Offset="1"/>
          </LinearGradientBrush>
        </Path.Fill>
      </Path>
      <Path Canvas.Left="47.875" Canvas.Top="36" Data="M0,0 H5.875 V15.875 H13.75 V21.5 H0 Z">
        <Path.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#C9D1CC" Offset="1"/>
          </LinearGradientBrush>
        </Path.Fill>
      </Path>
    </Canvas>

    <!-- Логотип Microsoft -->
    <Canvas x:Key="MsLogo" x:Shared="False" Width="80" Height="80">
      <Rectangle Canvas.Left="4" Canvas.Top="4" Width="34" Height="34" Fill="#F25022"/>
      <Rectangle Canvas.Left="42" Canvas.Top="4" Width="34" Height="34" Fill="#7FBA00"/>
      <Rectangle Canvas.Left="4" Canvas.Top="42" Width="34" Height="34" Fill="#00A4EF"/>
      <Rectangle Canvas.Left="42" Canvas.Top="42" Width="34" Height="34" Fill="#FFB900"/>
    </Canvas>

    <!-- Файлик -->
    <Canvas x:Key="FileIcon" x:Shared="False" Width="14" Height="18">
      <Path Data="M0,0 H10 L14,4 V18 H0 Z" Fill="#10241B" Stroke="#22C55E" StrokeThickness="1.6" StrokeLineJoin="Round"/>
    </Canvas>
    <Canvas x:Key="FileIconLight" x:Shared="False" Width="14" Height="18">
      <Path Data="M0,0 H10 L14,4 V18 H0 Z" Fill="#10241B" Stroke="#E9F5EE" StrokeThickness="1.6" StrokeLineJoin="Round"/>
    </Canvas>
    <Canvas x:Key="FileIconRed" x:Shared="False" Width="14" Height="18">
      <Path Data="M0,0 H10 L14,4 V18 H0 Z" Fill="#26110F" Stroke="#EF4444" StrokeThickness="1.6" StrokeLineJoin="Round"/>
    </Canvas>

    <!-- Кнопка -->
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Анимация: файлики летают между логотипами -->
    <Storyboard x:Key="FlyStory" RepeatBehavior="Forever" Duration="0:0:4">
      <DoubleAnimation Storyboard.TargetName="F1" Storyboard.TargetProperty="(Canvas.Left)" From="189" To="317" BeginTime="0:0:0" Duration="0:0:2.4"/>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="F1" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0">
        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.36"/>
        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.92"/><LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
      </DoubleAnimationUsingKeyFrames>

      <DoubleAnimation Storyboard.TargetName="F2" Storyboard.TargetProperty="(Canvas.Left)" From="189" To="317" BeginTime="0:0:0.8" Duration="0:0:2.4"/>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="F2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.8">
        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.36"/>
        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.92"/><LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
      </DoubleAnimationUsingKeyFrames>

      <DoubleAnimation Storyboard.TargetName="F3" Storyboard.TargetProperty="(Canvas.Left)" From="189" To="317" BeginTime="0:0:1.6" Duration="0:0:2.4"/>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="F3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.6">
        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.36"/>
        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.92"/><LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
      </DoubleAnimationUsingKeyFrames>

      <DoubleAnimation Storyboard.TargetName="F4" Storyboard.TargetProperty="(Canvas.Left)" From="317" To="189" BeginTime="0:0:0.4" Duration="0:0:2.4"/>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="F4" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.4">
        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.36"/>
        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.92"/><LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
      </DoubleAnimationUsingKeyFrames>

      <DoubleAnimation Storyboard.TargetName="F5" Storyboard.TargetProperty="(Canvas.Left)" From="317" To="189" BeginTime="0:0:1.2" Duration="0:0:2.4"/>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="F5" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.2">
        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.36"/>
        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.92"/><LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Анимация успеха: логотипы сближаются и обнимаются -->
    <Storyboard x:Key="SuccessStory">
      <DoubleAnimation Storyboard.TargetName="FlOk" Storyboard.TargetProperty="(Canvas.Left)" From="100" To="174" Duration="0:0:0.7">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="FlOk" Storyboard.TargetProperty="(Canvas.Top)" From="130" To="134" Duration="0:0:0.7"/>
      <DoubleAnimation Storyboard.TargetName="FlOkRot" Storyboard.TargetProperty="Angle" From="0" To="7" Duration="0:0:0.7">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="MsOk" Storyboard.TargetProperty="(Canvas.Left)" From="345" To="268" Duration="0:0:0.7">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="MsOk" Storyboard.TargetProperty="(Canvas.Top)" From="122" To="136" Duration="0:0:0.7"/>

      <DoubleAnimation Storyboard.TargetName="Arms" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.3"/>

      <DoubleAnimation Storyboard.TargetName="BadgeScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" BeginTime="0:0:0.6" Duration="0:0:0.5">
        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="BadgeScale" Storyboard.TargetProperty="ScaleY" From="0" To="1" BeginTime="0:0:0.6" Duration="0:0:0.5">
        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>

      <DoubleAnimation Storyboard.TargetName="Sp1" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.9" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Sp2" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.3" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Sp3" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.7" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Sp4" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.1" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>

      <DoubleAnimation Storyboard.TargetName="OkGlow" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"/>
    </Storyboard>

    <!-- Анимация ошибки: файлики падают, связь оборвана -->
    <Storyboard x:Key="ErrorStory" RepeatBehavior="Forever" Duration="0:0:2.4">
      <DoubleAnimation Storyboard.TargetName="D1" Storyboard.TargetProperty="(Canvas.Top)" From="170" To="232" BeginTime="0:0:0" Duration="0:0:2.2"/>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="D1" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0">
        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.4"/><LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.2"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimation Storyboard.TargetName="D2" Storyboard.TargetProperty="(Canvas.Top)" From="170" To="232" BeginTime="0:0:1.1" Duration="0:0:1.3"/>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="D2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.1">
        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.3"/><LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.3"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimation Storyboard.TargetName="ErrBadgeScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.12" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="ErrBadgeScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.12" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
    </Storyboard>
  </Window.Resources>

  <Grid MouseLeftButtonDown="Drag">
    <!-- Фон окна -->
    <Border x:Name="RootBorder" CornerRadius="18" BorderBrush="#1F3D2F" BorderThickness="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop x:Name="BgStop1" Color="#0C1A14" Offset="0"/>
          <GradientStop x:Name="BgStop2" Color="#07110D" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Canvas Width="520" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top">

      <!-- Свечение -->
      <Ellipse Canvas.Left="10" Canvas.Top="25" Width="500" Height="300" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop x:Name="GlowStop1" Color="#4722C55E" Offset="0"/>
            <GradientStop x:Name="GlowStop2" Color="#0022C55E" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Заголовок -->
      <Viewbox Canvas.Left="20" Canvas.Top="16" Width="24" Height="24">
        <ContentControl Content="{StaticResource FlLogo}" IsTabStop="False"/>
      </Viewbox>
      <TextBlock Canvas.Left="54" Canvas.Top="14" Text="F Launcher" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>

      <Button Canvas.Left="431" Canvas.Top="16" Width="34" Height="28" Style="{StaticResource FlatButton}" Background="Transparent" Click="Minimize_Click">
        <Path x:Name="MinGlyph" Data="M0,0 H14" Stroke="#7F9C8B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>
      <Button Canvas.Left="471" Canvas.Top="16" Width="34" Height="28" Style="{StaticResource FlatButton}" Background="Transparent" Click="Close_Click">
        <Path x:Name="CloseGlyph" Data="M0,0 L12,12 M12,0 L0,12" Stroke="#7F9C8B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>

      <!-- ===================== ОЖИДАНИЕ ===================== -->
      <Canvas x:Name="WaitPage" Width="520" Height="640">
        <ContentControl Canvas.Left="100" Canvas.Top="130" Content="{StaticResource FlLogo}" IsTabStop="False"/>
        <ContentControl Canvas.Left="341" Canvas.Top="118" Content="{StaticResource MsLogo}" IsTabStop="False" RenderTransformOrigin="0.5,0.5">
          <ContentControl.RenderTransform><RotateTransform Angle="8"/></ContentControl.RenderTransform>
        </ContentControl>

        <Line X1="192" Y1="170" X2="328" Y2="170" Stroke="#5922C55E" StrokeThickness="2"
              StrokeDashArray="1.5 3.5" StrokeDashCap="Round"/>

        <ContentControl x:Name="F1" Canvas.Left="189" Canvas.Top="151" Opacity="0" Content="{StaticResource FileIcon}" IsTabStop="False"/>
        <ContentControl x:Name="F2" Canvas.Left="189" Canvas.Top="151" Opacity="0" Content="{StaticResource FileIcon}" IsTabStop="False"/>
        <ContentControl x:Name="F3" Canvas.Left="189" Canvas.Top="151" Opacity="0" Content="{StaticResource FileIcon}" IsTabStop="False"/>
        <ContentControl x:Name="F4" Canvas.Left="317" Canvas.Top="173" Opacity="0" Content="{StaticResource FileIconLight}" IsTabStop="False"/>
        <ContentControl x:Name="F5" Canvas.Left="317" Canvas.Top="173" Opacity="0" Content="{StaticResource FileIconLight}" IsTabStop="False"/>

        <Border Canvas.Left="145" Canvas.Top="268" Width="230" Height="28" CornerRadius="14"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentEdge}" BorderThickness="1">
          <TextBlock x:Name="StatusPillText" Text="Ожидание авторизации…" FontSize="13" FontWeight="Bold"
                     Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="10,0"/>
        </Border>

        <TextBlock Canvas.Top="308" Width="520" TextAlignment="Center" Text="Подтвердите вход" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock x:Name="HintText" Canvas.Left="40" Canvas.Top="346" Width="440" TextAlignment="Center" TextWrapping="Wrap" Text="Откройте страницу и введите код" FontSize="14" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="VerificationUriText" Canvas.Top="366" Width="520" TextAlignment="Center" Text="microsoft.com/link"
                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" Cursor="Hand" MouseLeftButtonUp="Link_Click"/>

        <!-- Код -->
        <Border Canvas.Left="60" Canvas.Top="408" Width="400" Height="84" CornerRadius="16"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
        <TextBlock Canvas.Left="82" Canvas.Top="420" Text="КОД ПОДТВЕРЖДЕНИЯ" FontSize="11" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="CodeText" Canvas.Left="82" Canvas.Top="438" Text="AB12-CD34" FontSize="31" FontWeight="Bold"
                   FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextBrush}"/>

        <Button x:Name="CopyButton" Canvas.Left="326" Canvas.Top="436" Width="116" Height="40"
                Style="{StaticResource FlatButton}" Background="{StaticResource AccentGrad}" Click="Copy_Click">
          <Grid>
            <StackPanel x:Name="CopyNormal" Orientation="Horizontal">
              <Canvas Width="15" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                <Path Canvas.Left="2" Canvas.Top="3" Data="M2.5,0 H8.5 A2.5,2.5 0 0 1 11,2.5 V8.5 A2.5,2.5 0 0 1 8.5,11 H2.5 A2.5,2.5 0 0 1 0,8.5 V2.5 A2.5,2.5 0 0 1 2.5,0 Z"
                      Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                <Path Data="M0,9 V2 A2,2 0 0 1 2,0 H9" Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round"/>
              </Canvas>
              <TextBlock Text="Копировать" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="CopyDone" Orientation="Horizontal" Visibility="Collapsed">
              <Path Data="M0,6 L5,12 L15,0" Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Скопировано" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Button>

        <TextBlock x:Name="TimerText" Canvas.Top="507" Width="520" TextAlignment="Center" Text="Код действителен ещё 15:00"
                   FontSize="13" Foreground="{StaticResource Muted}"/>
        <Border Canvas.Left="60" Canvas.Top="534" Width="400" Height="4" CornerRadius="2" Background="{StaticResource Panel2}"/>
        <Border x:Name="TimerFill" Canvas.Left="60" Canvas.Top="534" Width="400" Height="4" CornerRadius="2" Background="{StaticResource Accent}"/>

        <Button Canvas.Left="60" Canvas.Top="560" Width="400" Height="44" Style="{StaticResource FlatButton}"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" FontSize="14" FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}" Content="Отмена" Click="Close_Click"/>
      </Canvas>

      <!-- ===================== УСПЕХ ===================== -->
      <Canvas x:Name="SuccessPage" Width="520" Height="640" Visibility="Collapsed">
        <Ellipse x:Name="OkGlow" Canvas.Left="90" Canvas.Top="85" Width="340" Height="180" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#4722C55E" Offset="0"/>
              <GradientStop Color="#0022C55E" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <ContentControl x:Name="FlOk" Canvas.Left="174" Canvas.Top="134" Content="{StaticResource FlLogo}" IsTabStop="False" RenderTransformOrigin="0.5,0.5">
          <ContentControl.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
              <RotateTransform x:Name="FlOkRot" Angle="7"/>
            </TransformGroup>
          </ContentControl.RenderTransform>
        </ContentControl>
        <ContentControl x:Name="MsOk" Canvas.Left="268" Canvas.Top="136" Content="{StaticResource MsLogo}" IsTabStop="False" RenderTransformOrigin="0.5,0.5">
          <ContentControl.RenderTransform><RotateTransform Angle="8"/></ContentControl.RenderTransform>
        </ContentControl>

        <!-- Руки -->
        <Canvas x:Name="Arms" Opacity="0">
          <Path Canvas.Left="246" Canvas.Top="196" Data="M0,0 C14.7,11.9 31.7,13.2 51,3.95" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Stroke>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#16683B" Offset="0.5"/>
                <GradientStop Color="#0690B6" Offset="0.96"/>
              </LinearGradientBrush>
            </Path.Stroke>
          </Path>
          <Path Canvas.Left="214" Canvas.Top="196" Data="M60,0 C42.7,12 22.7,13.3 0,4" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Stroke>
              <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                <GradientStop Color="#0690B7" Offset="0.2"/>
                <GradientStop Color="#249E59" Offset="0.55"/>
              </LinearGradientBrush>
            </Path.Stroke>
          </Path>
        </Canvas>

        <!-- Галочка -->
        <Grid Canvas.Left="243" Canvas.Top="95" Width="34" Height="34" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <Ellipse Fill="{StaticResource Accent}"/>
          <Path Data="M-7.5,0 L-2.5,6 L7.5,-6" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
        </Grid>

        <!-- Искры -->
        <Path x:Name="Sp1" Canvas.Left="144" Canvas.Top="114" Opacity="0" Fill="{StaticResource Accent}" Data="M6,0 L7.8,4.2 L12,6 L7.8,7.8 L6,12 L4.2,7.8 L0,6 L4.2,4.2 Z"/>
        <Path x:Name="Sp2" Canvas.Left="366" Canvas.Top="120" Opacity="0" Fill="{StaticResource Accent}" Data="M6,0 L7.8,4.2 L12,6 L7.8,7.8 L6,12 L4.2,7.8 L0,6 L4.2,4.2 Z"/>
        <Path x:Name="Sp3" Canvas.Left="124" Canvas.Top="194" Opacity="0" Fill="{StaticResource Accent}" Data="M6,0 L7.8,4.2 L12,6 L7.8,7.8 L6,12 L4.2,7.8 L0,6 L4.2,4.2 Z"/>
        <Path x:Name="Sp4" Canvas.Left="386" Canvas.Top="198" Opacity="0" Fill="{StaticResource Accent}" Data="M6,0 L7.8,4.2 L12,6 L7.8,7.8 L6,12 L4.2,7.8 L0,6 L4.2,4.2 Z"/>

        <Border Canvas.Left="185" Canvas.Top="268" Width="150" Height="28" CornerRadius="14"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentEdge}" BorderThickness="1">
          <TextBlock Text="Успешно" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Canvas.Top="308" Width="520" TextAlignment="Center" Text="Вход выполнен" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock x:Name="SuccessSub" Canvas.Top="346" Width="520" TextAlignment="Center" Text="Добро пожаловать в F Launcher" FontSize="14" Foreground="{StaticResource Muted}"/>

        <!-- Карточка аккаунта -->
        <Border Canvas.Left="60" Canvas.Top="408" Width="400" Height="84" CornerRadius="16"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
        <Canvas Canvas.Left="80" Canvas.Top="426" Width="48" Height="48">
          <Ellipse Width="48" Height="48" Fill="{StaticResource AccentGrad}"/>
          <Ellipse Canvas.Left="15" Canvas.Top="9" Width="18" Height="18" Stroke="#7F9C8B" StrokeThickness="2"/>
          <Path Data="M12,40 C16,28 32,28 36,40" Stroke="#7F9C8B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
        <TextBlock x:Name="PlayerName" Canvas.Left="144" Canvas.Top="428" Text="Player" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <Ellipse Canvas.Left="144" Canvas.Top="459" Width="8" Height="8" Fill="{StaticResource Accent}"/>
        <TextBlock Canvas.Left="158" Canvas.Top="456" Text="Аккаунт Microsoft · лицензия подтверждена" FontSize="12.5" Foreground="{StaticResource Muted}"/>

        <Button Canvas.Left="59" Canvas.Top="530" Width="400" Height="48" Style="{StaticResource FlatButton}"
                Background="{StaticResource AccentGrad}" Content="Играть" Click="Close_Click"/>
        <Button Canvas.Left="59" Canvas.Top="584" Width="400" Height="34" Style="{StaticResource FlatButton}"
                Background="Transparent" FontSize="14" Foreground="{StaticResource TextBrush}" Content="Закрыть" Click="Close_Click"/>
      </Canvas>

      <!-- ===================== ОШИБКА ===================== -->
      <Canvas x:Name="ErrorPage" Width="520" Height="640" Visibility="Collapsed">
        <ContentControl Canvas.Left="84" Canvas.Top="120" Content="{StaticResource FlLogo}" IsTabStop="False" Opacity="0.9" RenderTransformOrigin="0.5,0.5">
          <ContentControl.RenderTransform><RotateTransform Angle="-8"/></ContentControl.RenderTransform>
        </ContentControl>
        <ContentControl Canvas.Left="356" Canvas.Top="120" Content="{StaticResource MsLogo}" IsTabStop="False" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
          <ContentControl.RenderTransform><RotateTransform Angle="8"/></ContentControl.RenderTransform>
        </ContentControl>

        <Line X1="176" Y1="160" X2="228" Y2="160" Stroke="#80EF4444" StrokeThickness="2" StrokeDashArray="1.5 3.5" StrokeDashCap="Round"/>
        <Line X1="292" Y1="160" X2="344" Y2="160" Stroke="#80EF4444" StrokeThickness="2" StrokeDashArray="1.5 3.5" StrokeDashCap="Round"/>

        <ContentControl x:Name="D1" Canvas.Left="207" Canvas.Top="170" Opacity="0" Content="{StaticResource FileIconRed}" IsTabStop="False"/>
        <ContentControl x:Name="D2" Canvas.Left="299" Canvas.Top="170" Opacity="0" Content="{StaticResource FileIconRed}" IsTabStop="False"/>

        <Grid Canvas.Left="243" Canvas.Top="143" Width="34" Height="34" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform x:Name="ErrBadgeScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <Ellipse Fill="#DC2626"/>
          <Path Data="M-6,-6 L6,6 M6,-6 L-6,6" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Border Canvas.Left="155" Canvas.Top="268" Width="210" Height="28" CornerRadius="14"
                Background="{StaticResource ErrSoft}" BorderBrush="{StaticResource ErrEdge}" BorderThickness="1">
          <TextBlock Text="Ошибка авторизации" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Err}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Canvas.Top="308" Width="520" TextAlignment="Center" Text="Не удалось войти" FontSize="25" FontWeight="Bold" Foreground="{StaticResource ErrText}"/>
        <TextBlock x:Name="ErrorSub" Canvas.Left="40" Canvas.Top="346" Width="440" TextAlignment="Center" Text="Код истёк или вход был отклонён"
                   FontSize="13" MaxHeight="58" TextTrimming="CharacterEllipsis" Foreground="{StaticResource ErrMuted}" TextWrapping="Wrap"/>

        <Border Canvas.Left="60" Canvas.Top="408" Width="400" Height="84" CornerRadius="16"
                Background="{StaticResource ErrPanel}" BorderBrush="{StaticResource ErrLine}" BorderThickness="1"/>
        <TextBlock Canvas.Left="82" Canvas.Top="420" Text="КОД ОШИБКИ" FontSize="11" Foreground="{StaticResource ErrMuted}"/>
        <TextBlock x:Name="ErrorCodeText" Canvas.Left="82" Canvas.Top="446" Text="AUTH_CODE_EXPIRED" FontSize="20" FontWeight="Bold"
                   FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Err}"/>

        <Button Canvas.Left="60" Canvas.Top="516" Width="400" Height="48" Style="{StaticResource FlatButton}"
                Background="{StaticResource ErrGrad}" Content="Повторить" Click="Retry_Click"/>
        <Button Canvas.Left="60" Canvas.Top="574" Width="400" Height="42" Style="{StaticResource FlatButton}"
                Background="{StaticResource ErrPanel}" BorderBrush="{StaticResource ErrLine}" FontSize="14" FontWeight="SemiBold"
                Foreground="{StaticResource ErrText}" Content="Отмена" Click="Close_Click"/>
      </Canvas>
    </Canvas>
  </Grid>
</Window>
