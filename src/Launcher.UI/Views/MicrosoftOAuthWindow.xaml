<Window x:Class="Launcher.UI.Views.MicrosoftOAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Вход через Microsoft" Width="960" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#08140F" Foreground="#E9F5EE">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="16,10">
            <Button DockPanel.Dock="Right" Content="Закрыть" Padding="12,6" Click="Close_Click" />
            <StackPanel>
                <TextBlock Text="Вход в F Launcher" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="Откройте страницу Microsoft и завершите вход."
                           Foreground="#A8BEB2" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Window>