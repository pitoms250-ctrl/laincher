<Window x:Class="Launcher.UI.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать в F Launcher" Width="1040" Height="660" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FontFamily="Inter, Montserrat, Segoe UI" Foreground="White" UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality" Closed="Window_Closed">
    <Border Margin="8" CornerRadius="22" BorderBrush="#6639FF14" BorderThickness="1.5" Padding="18" MouseLeftButtonDown="Drag">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#03140E" Offset="0"/>
                <GradientStop Color="#0B3D2E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Skip_Click"/>
                <Border Width="38" Height="39" CornerRadius="10" BorderBrush="#57F287" BorderThickness="1.5" Background="#1FBF4A" ClipToBounds="True">
                    <Image Source="/imge/c8d995ff-a413-46dc-8cd7-9ac3c465d208.jpg" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="F Launcher" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Furry Launcher · знакомство" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </DockPanel>

            <!-- слайд -->
            <Border Grid.Row="1" CornerRadius="18" ClipToBounds="True" BorderBrush="#5557F287" BorderThickness="1" Background="#04140E">
                <Grid>
                    <Image x:Name="ImgBack" Stretch="UniformToFill"/>
                    <Image x:Name="ImgFront" Stretch="UniformToFill"/>
                    <Border VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#E6021510" Offset="0.55"/>
                                <GradientStop Color="#F2021510" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="26,46,26,18" x:Name="TextPanel">
                            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SpokenText" FontSize="15" Foreground="#D6F5E6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="Chips" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="14" Background="#CC0B3D2E" BorderBrush="#57F287" BorderThickness="1" Padding="12,5" Margin="0,0,0,6" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#7CFFCB"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- управление -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar x:Name="Bar" Maximum="1" Height="6" BorderThickness="0" Foreground="#3DDC84" Background="#33000000"/>
                    <TextBlock x:Name="Hint" Text="Включите звук — лаунчер сам о себе расскажет" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
                    <Button x:Name="MuteBtn" Style="{StaticResource OutlineButton}" Content="&#xE767;"
                            ToolTip="Включить или выключить звук" Click="Mute_Click" />
                    <Button Style="{StaticResource OutlineButton}" Content="Пропустить" Margin="10,0,0,0" Click="Skip_Click"/>
                    <Button x:Name="StartBtn" Style="{StaticResource PlayButton}" Content="Начать!" FontSize="16" Padding="26,0" Height="42" Margin="10,0,0,0" Click="Skip_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
